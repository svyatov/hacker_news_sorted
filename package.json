{
  "name": "hacked_news_sorted",
  "displayName": "Hacker News Sorted",
  "version": "2.6.1",
  "description": "Instantly sort Hacker News by points, time, comments, velocity, or heat, mark new posts, and highlight comment authors.",
  "author": "Leonid Svyatov <leonid@svyatov.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "release": "bun run build && bun run package",
    "test": "vitest run",
    "test:integration": "vitest run app/utils/selectors.integration.test.ts app/utils/comments.integration.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "fixture:update": "bun app/__fixtures__/updateFixture.ts",
    "screenshots": "bun scripts/generate-screenshots.ts",
    "demo": "bun scripts/generate-demo.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint",
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "baseline-browser-mapping": "^2.11.19",
    "caniuse-lite": "^1.0.30001810",
    "plasmo": "0.90.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.2.7",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "manifest": {
    "host_permissions": [
      "https://news.ycombinator.com/*"
    ]
  },
  "overrides": {
    "caniuse-lite": "^1.0.30001799",
    "msgpackr": "^1.11.2",
    "lmdb": "^3.4.4",
    "svelte": "^4.2.19",
    "content-security-policy-parser": "^0.6.0"
  }
}
